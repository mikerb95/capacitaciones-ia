{
  "name": "capacitaciones-ia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed/index.ts",
    "db:seed:master": "tsx --env-file=.env.local src/db/seed/master.ts",
    "db:seed:demo": "tsx --env-file=.env.local src/db/seed/demo.ts",
    "logos": "tsx scripts/gen-logo-assets.mts",
    "materiales": "tsx --env-file=.env.local scripts/build-materiales.ts",
    "materiales:empresa": "tsx --env-file=.env.local scripts/build-materiales-empresa.mts",
    "materiales:subir": "tsx --env-file=.env.local scripts/subir-materiales-empresa.mts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "country-flag-icons": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "node-html-parser": "^9.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "puppeteer": "^25.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
