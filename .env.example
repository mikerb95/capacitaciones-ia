# Turso: crea la base con `turso db create capacitaciones-ia`
# y saca las credenciales con `turso db show --url` y `turso db tokens create`
TURSO_DATABASE_URL="libsql://tu-base.turso.io"
TURSO_AUTH_TOKEN="tu-token"

# Para desarrollo local sin Turso, un archivo SQLite sirve igual:
# TURSO_DATABASE_URL="file:./local.db"

# Login de /admin. Sin estas dos, el panel queda cerrado.
ADMIN_USER=""
ADMIN_PASS=""

# Opcional: clave con la que se firma la cookie del admin. Si no está, se firma
# con ADMIN_PASS, y entonces cambiar la contraseña cierra las sesiones abiertas.
ADMIN_SECRET=""

# Vercel Blob: donde vive el material a medida de cada empresa. Lo pone
# `vercel blob create-store <nombre> --access private`; en local se trae con
# `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=""

# Las rutas de /materiales son el insumo del generador de PDF, no una sección
# del sitio: fuera de desarrollo solo responden a quien mande esta clave. Tiene
# que ser la misma acá y en el proyecto de Vercel, o `npm run materiales`
# contra producción recibe 404 en todo. En local no hace falta.
MATERIALES_BUILD_KEY=""

# Contra qué servidor genera el material. Por defecto, el de desarrollo.
# MATERIALES_URL="https://tu-sitio.vercel.app"
